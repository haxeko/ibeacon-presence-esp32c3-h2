# Two-chip version, ESP32-C3 scanner. Applied after ../common/sdkconfig.defaults (shared
# settings; its Matter settings are unknown symbols here, reported as NOTE lines by the build).
CONFIG_IDF_TARGET="esp32c3"
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../common/partitions.csv"

CONFIG_PRESENCE_ROLE_SCANNER=y

# UART link to the ESP32-H2, as wired: H2 TX -> C3 GPIO21 (RX here), H2 RX -> C3 GPIO20 (TX here). GPIO20/21 are the
# UART0 pins of the ESP32-C3: the console moves to USB-Serial-JTAG only, and the ROM still prints its boot messages
# on GPIO21 for a moment at every reset (see README).
CONFIG_PRESENCE_LINK_UART_NUM=1
CONFIG_PRESENCE_LINK_TX_GPIO=20
CONFIG_PRESENCE_LINK_RX_GPIO=21
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# Fixed password of the configuration SoftAP (the same on every device)
CONFIG_PRESENCE_AP_PASSWORD="69696969"

# The radio serves BLE only in NORMAL mode (no Matter, no Wi-Fi): 120 ms of every 160 ms scanning (75 %) by default
CONFIG_PRESENCE_SCAN_WINDOW_MS=120

# Wi-Fi only for the SoftAP of the CONFIG mode, nothing kept in flash. No Matter on this chip: the RAM allows the
# driver defaults (buffers, Wi-Fi code in IRAM) that the Matter builds trim
CONFIG_ESP_WIFI_NVS_ENABLED=n
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=32
CONFIG_ESP_WIFI_IRAM_OPT=y
CONFIG_ESP_WIFI_RX_IRAM_OPT=y

# Duplicate filtering is off in every scan (filter_duplicates = 0); refresh the controller list every second should
# one ever be started with it on (refresh period 0 = never)
CONFIG_BT_CTRL_DUPL_SCAN_CACHE_REFRESH_PERIOD=1
