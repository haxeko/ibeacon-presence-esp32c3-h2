# Matter settings of the versions that run Matter (loaded after sdkconfig.defaults and its .<target> file by
# ble_presence.cmake; not by the scanner of the two-chip version).

# Keep BLE after commissioning: by default the SDK shuts NimBLE down and releases its memory once commissioned
# (FAQ A1.16), which would stop the scanner for good. (The ESP32-H2 of the two-chip version sets it back to y.)
CONFIG_USE_BLE_ONLY_FOR_COMMISSIONING=n

# ---------------------------------------------------------------------------------------------------------------------
# Matter
# Test vendor 0xFFF1; each version has its own product ID (sdkconfig.defaults.esp32c6: 0x8002, ESP32-C3: 0x8003,
# ESP32-H2 of the two-chip version: 0x8004),
# covered by the SDK example DAC, PAI and Certification Declaration (0xFFF1/0x8000-0x801F). Development credentials
# only, see README.
CONFIG_DEVICE_VENDOR_ID=0xFFF1
# Root node and five Occupancy Sensor endpoints (endpoint ids 0-5, fixed by the creation order)
CONFIG_ESP_MATTER_MAX_DYNAMIC_ENDPOINT_COUNT=6
CONFIG_CHIP_PROJECT_CONFIG="main/chip_project_config.h"
# Device type in commissionable discovery (DNS-SD "DT"): 263 = 0x0107 Occupancy Sensor
CONFIG_ENABLE_COMMISSIONABLE_DEVICE_TYPE=y
CONFIG_DEVICE_TYPE=263
CONFIG_BLE_DEVICE_NAME_PREFIX="Presence-"
# No OTA in this version
CONFIG_ENABLE_OTA_REQUESTOR=n
# TC_RR_1_1 requires MaxGroupKeysPerFabric >= 4
CONFIG_MAX_GROUP_KEYS_PER_FABRIC=4

# Clusters no endpoint of this device has: less flash. Kept: the root node clusters, Identify, Occupancy Sensing,
# and Binding, Groups, Scenes, On/Off, Level and Color Control (code the SDK builds anyway); the network diagnostics
# cluster is chosen with the network (h2-bridge/sdkconfig.defaults: Thread).
# Generated from components/esp_matter/utils/cluster_select/Kconfig.in of esp-matter v1.6.1.
